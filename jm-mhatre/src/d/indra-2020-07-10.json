[{"pressReleaseID":41664,"reportID":null,"reportTableReportID":null,"pressReleaseTitle":"India Ratings Downgrades JM Mhatre Infra Private Limited to ‘IND BB(ISSUER NOT COOPERATING)’","prTypeID":null,"reportTypeID":null,"version":"old","prTypeName":"RAC","pressReleaseDate":null,"acceptanceStatus":"Yes","imagePath":null,"thumbNailImagePath":"https://www.indiaratings.co.in/data/Uploads/PressReleases/41664/Images/1.jpg","financialSummaryPath":"","description":null,"documentTitle":null,"documentType":null,"queryType":null,"isRAC":true,"sector":"Corporates","subSector":"Transport Infrastructure","issuerID":2979,"issuerName":"JM Mhatre Infra Private Limited","overview":"India Ratings and Research (Ind-Ra) has downgraded JM Mhatre Infra Private Limited Long-Term Issuer Rating to ‘IND BB(ISSUER NOT COOPERATING)’ from ‘IND BBB-(ISSUER NOT COOPERATING)’. The issuer did not participate in the rating exercise despite continuous requests and follow-ups by the agency. The instrument-wise rating action is as follows:\t","overviewHTML":null,"keyRatingDrivers":"<p style='margin-top:0in;margin-right:0in;margin-bottom:.0001pt;margin-left:0in;line-height:115%;font-size:15px;font-family:\"Calibri\",\"sans-serif\";text-align:justify;background:white;'><span style=\"font-size:13px;line-height:115%;color:black;background:white;\">The downgrade is pursuant to SEBI Circular SEBI/HO/MIRSD/CRADT/CIR/P/2020/2 dated 3rd January 2020. As per Circular any issuer having investment grade rating remains non cooperative with rating agency for more than 6 months should be downgraded to sub investment grade rating. Please refer agency&rsquo;s website&nbsp;</span><a href=\"http://www.indiarating.co.in\"><span style=\"font-size:13px;line-height:115%;color:black;text-decoration:none;\">www.indiarating.co.in</span></a><span style=\"font-size:13px;line-height:115%;color:black;background:white;\">. JM Mhatre Infra Private Limited has been non cooperative with the agency from &nbsp;25 Sep 2018</span><span style=\"font-size:13px;line-height:115%;color:black;background:white;\">&nbsp;</span></p>\r\n<p style='margin-top:0in;margin-right:0in;margin-bottom:.0001pt;margin-left:0in;line-height:115%;font-size:15px;font-family:\"Calibri\",\"sans-serif\";text-align:justify;background:white;'><span style=\"font-size:13px;line-height:115%;color:black;background:white;\">Current outstanding rating of IND BB(Issuer Not Cooperating) may not reflect it&rsquo;s credit strength as the issuer has been non cooperative with agency, therefore, investors and other users are advised to take appropriate caution while using these ratings.</span></p>","ratingSensitivities":null,"esg":null,"companyProfile":"<p><!--[if gte mso 9]><xml>\r\n <o:OfficeDocumentSettings>\r\n  <o:RelyOnVML></o:RelyOnVML>\r\n  <o:AllowPNG></o:AllowPNG>\r\n </o:OfficeDocumentSettings>\r\n</xml><![endif]--><!--[if gte mso 9]><xml>\r\n <w:WordDocument>\r\n  <w:View>Normal</w:View>\r\n  <w:Zoom>0</w:Zoom>\r\n  <w:TrackMoves></w:TrackMoves>\r\n  <w:TrackFormatting></w:TrackFormatting>\r\n  <w:PunctuationKerning></w:PunctuationKerning>\r\n  <w:ValidateAgainstSchemas></w:ValidateAgainstSchemas>\r\n  <w:SaveIfXMLInvalid>false</w:SaveIfXMLInvalid>\r\n  <w:IgnoreMixedContent>false</w:IgnoreMixedContent>\r\n  <w:AlwaysShowPlaceholderText>false</w:AlwaysShowPlaceholderText>\r\n  <w:DoNotPromoteQF></w:DoNotPromoteQF>\r\n  <w:LidThemeOther>EN-US</w:LidThemeOther>\r\n  <w:LidThemeAsian>X-NONE</w:LidThemeAsian>\r\n  <w:LidThemeComplexScript>X-NONE</w:LidThemeComplexScript>\r\n  <w:Compatibility>\r\n   <w:BreakWrappedTables></w:BreakWrappedTables>\r\n   <w:SnapToGridInCell></w:SnapToGridInCell>\r\n   <w:WrapTextWithPunct></w:WrapTextWithPunct>\r\n   <w:UseAsianBreakRules></w:UseAsianBreakRules>\r\n   <w:DontGrowAutofit></w:DontGrowAutofit>\r\n   <w:SplitPgBreakAndParaMark></w:SplitPgBreakAndParaMark>\r\n   <w:EnableOpenTypeKerning></w:EnableOpenTypeKerning>\r\n   <w:DontFlipMirrorIndents></w:DontFlipMirrorIndents>\r\n   <w:OverrideTableStyl